{
  "name": "@yggdrion/jscaw",
  "version": "0.2.5",
  "description": "Windows-only native addon to list active Core Audio sessions and control per-process volume/mute",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yggdrion/jscaw.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "napi": {
    "binaryName": "jscaw",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ],
    "packageName": "@yggdrion/jscaw"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test",
    "artifacts": "napi artifacts",
    "release": "node scripts/release.mjs",
    "smoke-test": "node scripts/smoke-test-main.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6"
  },
  "packageManager": "pnpm@12.4.1"
}
