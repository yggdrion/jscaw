{
  "name": "jscaw",
  "version": "0.3.1",
  "description": "Windows-only native addon to list active Core Audio sessions and control per-process volume/mute",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yggdrion/jscaw.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./magic": {
      "types": "./magic.d.mts",
      "default": "./magic.mjs"
    },
    "./package.json": "./package.json"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "napi": {
    "binaryName": "jscaw",
    "constEnum": false,
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ],
    "packageName": "jscaw"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "magic.mjs",
    "magic.d.mts"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test",
    "artifacts": "napi artifacts",
    "release": "node scripts/release.mjs",
    "smoke-test": "node scripts/smoke-test-main.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6"
  },
  "packageManager": "pnpm@12.9.1"
}
